<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digital Alarm Clock</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: rgb(243, 158, 211);
            color: white;
            text-align: center;
            padding-top: 60px;
        }
        .bingkai-biru {
            background-color: rgb(166, 243, 130);
            width: 320px;
            margin: auto;
            padding: 15px;
        }
        .layar-putih {
            background-color: white;
            color: black;
            padding: 20px;
        }
        .hari {
            font-size: 10px;
            color: gray;
            margin-bottom: 10px;
        }
        .jam-digital {
            font-family: monospace;
            font-size: 38px;
            font-weight: bold;
        }
        .tombol-menu {
            width: 350px;
            margin: 20px auto;
        }
        button {
            background-color: rgb(130, 0, 61);
            color: white;
            border: none;
            padding: 10px 14px;
            margin: 5px 2px;
            font-weight: bold;
            cursor: pointer;
        }
    </style>
</head>
<body>

       <audio id="suara" src="https://google.com" loop></audio>

    <h2>Digital Alarm Clock Widget</h2>

    <div class="bingkai-biru">
        <div class="layar-putih" id="layar">
            00 : 00
        </div>
    </div>

    <div class="tombol-menu">
        <button onclick="
            jam = prompt('Masukkan jam alarm (contoh 05:30):');
            layar.innerHTML = jam;
            alert('Alarm diatur ke jam ' + jam);
        ">ATUR ALARM</button>

        <button onclick="
            aktif = 'Aktif';
            suara.play();
            alert('Alarm AKTIF pada jam ' + jam);
        ">AKTIFKAN</button>

        <button onclick="
            aktif = 'Tidak Aktif';
            suara.pause();
            alert('Alarm DIMATIKAN!');
        ">NONAKTIFKAN</button>

        <button onclick="
            alert('Jam Alarm: ' + jam + '\nStatus: ' + aktif);
        ">CEK STATUS</button>

        <button onclick="
            suara.pause();
            alert('Terima kasih!');
        ">EXIT</button>
    </div>

    <script>
        var jam = "00 : 00";
        var aktif = "Tidak Aktif";
    </script>
    
</body>
</html>